---
interface Version {
  filename: string;
  label: string;
  hash?: string;
}

interface Props {
  versions: Version[];
  latest: string;
}

interface MonthGroup {
  month: string;
  head: Version | null;
  revs: Version[];
  order: number;
}

const { versions, latest } = Astro.props;

const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];

/** "Jun '26 rev 12" → "Jun '26" */
const monthOf = (label: string) => label.replace(/\s*rev\s*\d+\s*$/i, '').trim();

/** "Jun '26 rev 12" → 12, "Jun '26" → -1 */
const revOf = (label: string) => {
  const m = label.match(/rev\s*(\d+)\s*$/i);
  return m ? Number(m[1]) : -1;
};

/** "Jun '26" → sortable month index, or -1 when the label has another form */
const monthOrder = (month: string) => {
  const m = month.match(/^([A-Za-z]{3})[A-Za-z]*\s+'?(\d{2,4})/);
  if (!m) return -1;
  const idx = MONTHS.indexOf(m[1].toLowerCase());
  if (idx < 0) return -1;
  const year = Number(m[2]) < 100 ? Number(m[2]) + 2000 : Number(m[2]);
  return year * 12 + idx;
};

// Group every version under its month, then sort newest to oldest.
const byMonth = new Map<string, MonthGroup>();

versions.forEach((v, i) => {
  const month = monthOf(v.label);
  let group = byMonth.get(month);
  if (!group) {
    group = { month, head: null, revs: [], order: i };
    byMonth.set(month, group);
  }
  if (revOf(v.label) < 0 && !group.head) group.head = v;
  else group.revs.push(v);
});

const groups = [...byMonth.values()];

groups.sort((a, b) => {
  const ka = monthOrder(a.month);
  const kb = monthOrder(b.month);
  if (ka !== kb && ka >= 0 && kb >= 0) return kb - ka;
  return a.order - b.order;
});

groups.forEach((g) => g.revs.sort((a, b) => revOf(b.label) - revOf(a.label)));

const urlOf = (v: Version) => `/resumes/${v.filename}${v.hash ? `?v=${v.hash}` : ''}`;

// Only the newest month opens on load. Older months stay collapsed.
// A month that holds the current version always opens, or you could not see it.
const holdsLatest = (g: MonthGroup) =>
  g.head?.filename === latest || g.revs.some((v) => v.filename === latest);

const isOpen = (g: MonthGroup, i: number) => i === 0 || holdsLatest(g);
---

<aside class="version-panel">
  <div class="panel-header">
    <span class="panel-title">version history</span>
    <span class="panel-count">[{versions.length}]</span>
  </div>

  {versions.length === 0 ? (
    <div class="no-versions">
      <span>no versions yet</span>
    </div>
  ) : (
    <ul class="version-list">
      {groups.map((group, gi) => (
        <li class="version-group">
          <div
            class={`version-item version-item--month${group.head?.filename === latest ? ' version-item--active' : ''}${group.head ? '' : ' version-item--static'}`}
          >
            {group.revs.length > 0 ? (
              <button
                class="version-caret"
                type="button"
                aria-expanded={isOpen(group, gi) ? 'true' : 'false'}
                aria-controls={`revs-${gi}`}
                aria-label={`Toggle the ${group.month} revisions`}
              >{isOpen(group, gi) ? '▾' : '▸'}</button>
            ) : (
              <span class="version-prefix">{group.head?.filename === latest ? '▶' : ' '}</span>
            )}

            {group.head ? (
              <button
                class="version-open version-label"
                type="button"
                data-url={urlOf(group.head)}
                data-filename={group.head.filename}
                title={group.head.filename}
              >{group.month}</button>
            ) : (
              <span class="version-label">{group.month}</span>
            )}

            {group.head?.filename === latest && <span class="version-badge">latest</span>}
          </div>

          {group.revs.length > 0 && (
            <ul class="version-sublist" id={`revs-${gi}`} hidden={!isOpen(group, gi)}>
              {group.revs.map((v) => (
                <li
                  class={`version-item version-item--rev${v.filename === latest ? ' version-item--active' : ''}`}
                  data-url={urlOf(v)}
                  data-filename={v.filename}
                  role="button"
                  tabindex="0"
                  title={v.filename}
                >
                  <span class="version-prefix">{v.filename === latest ? '▶' : ' '}</span>
                  <span class="version-label">{revOf(v.label) >= 0 ? `rev ${revOf(v.label)}` : v.label}</span>
                  {v.filename === latest && <span class="version-badge">latest</span>}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )}
</aside>

<style>
  .version-panel {
    display: flex;
    flex-direction: column;
    background: #000;
    border: 1px solid var(--dim, #3a4a3a);
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace;
    min-width: 0;
    height: 100%;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 12px;
    border-bottom: 1px solid var(--dim, #3a4a3a);
    flex-shrink: 0;
  }

  .panel-title {
    color: var(--primary, #98c379);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  .panel-count {
    color: var(--muted, #5a6a5a);
    font-size: 0.72rem;
  }

  .no-versions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 20px;
    color: var(--muted, #5a6a5a);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .version-list {
    list-style: none;
    margin: 0;
    padding: 4px 0;
    overflow-y: auto;
    flex: 1;
    scrollbar-width: thin;
    scrollbar-color: #3d3d3d #1a1a1a;
  }

  .version-list::-webkit-scrollbar { width: 4px; }
  .version-list::-webkit-scrollbar-track { background: #1a1a1a; }
  .version-list::-webkit-scrollbar-thumb { background: #3d3d3d; }
  .version-list::-webkit-scrollbar-thumb:hover { background: var(--primary, #98c379); }

  .version-group { list-style: none; }

  .version-sublist {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .version-sublist[hidden] { display: none; }

  /* Connecting line that ties the revisions to their month */
  .version-sublist::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 4px;
    width: 1px;
    background: var(--dimmer, #1e281e);
    pointer-events: none;
  }

  .version-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    cursor: pointer;
    color: var(--muted, #5a6a5a);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    border-left: 2px solid transparent;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
    user-select: none;
  }

  .version-item:hover {
    color: var(--primary, #98c379);
    background: rgba(152, 195, 121, 0.06);
    border-left-color: var(--dim, #3a4a3a);
  }

  .version-item:focus-visible {
    outline: 1px dashed var(--primary, #98c379);
    outline-offset: -2px;
  }

  .version-item--active {
    color: var(--primary, #98c379);
    border-left-color: var(--primary, #98c379);
    background: rgba(152, 195, 121, 0.05);
  }

  /* The month row itself is not clickable — its caret and label are */
  .version-item--month { cursor: default; }

  /* Revisions sit indented below their month header */
  .version-item--rev {
    padding-left: 30px;
    padding-top: 4px;
    padding-bottom: 4px;
    font-size: 0.72rem;
  }

  .version-item--static {
    cursor: default;
    color: var(--muted, #5a6a5a);
  }

  .version-item--static:hover {
    background: transparent;
    border-left-color: transparent;
    color: var(--muted, #5a6a5a);
  }

  .version-prefix {
    font-size: 0.62rem;
    width: 10px;
    flex-shrink: 0;
    color: var(--primary, #98c379);
  }

  .version-label { flex: 1; }

  /* Accordion control on every month that holds revisions */
  .version-caret {
    width: 10px;
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: 0.62rem;
    line-height: 1;
    text-align: left;
    cursor: pointer;
  }

  .version-caret:focus-visible,
  .version-open:focus-visible {
    outline: 1px dashed var(--primary, #98c379);
    outline-offset: 1px;
  }

  /* The month label opens that month's build */
  .version-open {
    min-width: 0;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: pointer;
  }

  .version-badge {
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: #000;
    background: var(--primary, #98c379);
    padding: 1px 4px;
    flex-shrink: 0;
  }
</style>

<script>
  // ── Load a version ──
  document.querySelectorAll('.version-panel [data-url]').forEach((el) => {
    const activate = () => {
      const url = el.dataset.url;
      if (!url) return;

      // Update active state
      document.querySelectorAll('.version-item').forEach((item) => {
        item.classList.remove('version-item--active');
        const prefix = item.querySelector('.version-prefix');
        if (prefix) prefix.textContent = ' ';
      });

      const row = el.closest('.version-item');
      if (row) {
        row.classList.add('version-item--active');
        const prefix = row.querySelector('.version-prefix');
        if (prefix) prefix.textContent = '▶';
      }

      // Update toolbar prompt
      const promptEl = document.querySelector('.prompt');
      if (promptEl) promptEl.textContent = el.dataset.filename;

      window.dispatchEvent(new CustomEvent('load-version', { detail: { url } }));
    };

    el.addEventListener('click', activate);

    // Real buttons already fire click on Enter and Space
    if (el.tagName !== 'BUTTON') {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
      });
    }
  });

  // ── Open and close a month ──
  document.querySelectorAll('.version-caret').forEach((caret) => {
    caret.addEventListener('click', () => {
      const list = document.getElementById(caret.getAttribute('aria-controls'));
      if (!list) return;

      const open = caret.getAttribute('aria-expanded') === 'true';
      caret.setAttribute('aria-expanded', String(!open));
      caret.textContent = open ? '▸' : '▾';
      list.hidden = open;
    });
  });
</script>
